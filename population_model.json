  "calculation_rules": {
    "base_population": 100000000,
    "age_interpolation": "For arbitrary age ranges, integrate the age-band distribution proportionally over the overlapping years.",
    "continuous_height": "Use a normal distribution with sex/age-specific mean and SD.",
    "continuous_weight": "Generate BMI from the specified distribution and derive weight from height.",
    "income": "Approximate the income distribution with a log-normal distribution calibrated to median and p90.",
    "categorical_filters": "Use conditional probabilities.",
    "correlation_adjustments": [
      "Higher education increases expected income.",
      "Employment status strongly affects income.",
      "Age affects marital status and children.",
      "Property ownership increases with age.",
      "Smoking and alcohol distributions vary by sex and age."
    ],
    "rounding": {
      "counts": "human_readable",
      "percentages": "maximum_2_decimal_places",
      "rarity": "nearest_reasonable_integer"
    },
    "rarity_formula": "1 / (estimated_count / relevant_population)",
    "relevant_population": "selected sex population when sex is selected; all adults otherwise"
  },
  "quality_labels": {
    "high": "Mostly based on demographic/social statistics.",
    "medium": "Combination of statistical and model-estimated distributions.",
    "low": "Heavily dependent on synthetic assumptions, especially physical traits."
  }
}
